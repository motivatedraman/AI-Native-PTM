# Database Configuration (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/app.db

# Single-User Authentication
AUTH_USERNAME=raman
AUTH_PASSWORD=admin123
JWT_SECRET=super-secret-jwt-key-nexus-os-secure-production-32-chars-long

# AI Service Configuration
# Supported providers: gemini, openai, anthropic, or mock
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Secret
SECRET_KEY=change-this-in-production-to-a-secure-random-string
